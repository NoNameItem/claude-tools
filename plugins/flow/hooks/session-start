#!/usr/bin/env python3
"""Emit Flow's shared runtime contract and active harness adapter."""

from __future__ import annotations

import json
import os
import sys

from _runtime import render_session_context


def main() -> int:
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict) or payload.get("hook_event_name") != "SessionStart":
            message = "expected SessionStart input"
            raise ValueError(message)
        context = render_session_context(os.environ)
        print(
            json.dumps(
                {
                    "hookSpecificOutput": {
                        "hookEventName": "SessionStart",
                        "additionalContext": context,
                    }
                }
            )
        )
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as exc:
        print(json.dumps({"systemMessage": f"Flow runtime adapter inactive: {exc}"}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
