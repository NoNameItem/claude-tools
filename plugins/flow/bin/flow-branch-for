#!/usr/bin/env python3
"""Compute the flow branch name for a beads task.

Usage: flow-branch-for <task-id>
Prints: <prefix><task-id>-<brief-name>   e.g. feature/claude-tools-uaj-extract-repeated-bash
Exit:   0 ok | 1 task not found | 2 bd error
"""

from __future__ import annotations

import argparse
import os
import sys

import _task_names

BD = os.environ.get("BD_BIN", "bd")
PREFIX_BY_TYPE = {"bug": "fix/", "chore": "chore/", "task": "feature/", "feature": "feature/", "epic": "feature/"}


def main():
    parser = argparse.ArgumentParser(description="Compute the flow branch name for a beads task.")
    parser.add_argument("task_id")
    task_id = parser.parse_args().task_id

    try:
        issue = _task_names.read_issue(BD, task_id)
    except _task_names.TaskLookupError as e:
        sys.stderr.write(e.message + "\n")
        return e.code

    issue_type = issue.get("issue_type", "")
    prefix = PREFIX_BY_TYPE.get(issue_type)
    if prefix is None:
        sys.stderr.write(f"unknown type {issue_type!r}; defaulting to feature/\n")
        prefix = "feature/"
    slug = _task_names.slugify(issue.get("title", ""))
    if slug:
        sys.stdout.write(f"{prefix}{task_id}-{slug}\n")
    else:
        sys.stderr.write("title produces empty slug; using task-id only\n")
        sys.stdout.write(f"{prefix}{task_id}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
