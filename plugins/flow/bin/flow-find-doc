#!/usr/bin/env python3
"""Print the newest design|plan doc across both v5+ and pre-v5 locations.

Usage: flow-find-doc <design|plan>
Prints the newest *.md path (relative to CWD) by mtime, or nothing if none exist.
Exit: 0 (empty = none) | 2 on bad kind (argparse).
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

LOCATIONS = {
    "design": ("docs/superpowers/specs", "docs/plans"),
    "plan": ("docs/superpowers/plans", "docs/plans"),
}


def main():
    parser = argparse.ArgumentParser(description="Print the newest design|plan doc across both doc locations.")
    parser.add_argument("kind", choices=sorted(LOCATIONS))
    kind = parser.parse_args().kind

    candidates = [p for d in LOCATIONS[kind] for p in Path(d).glob("*.md")]
    if not candidates:
        return 0
    sys.stdout.write(f"{max(candidates, key=lambda p: p.stat().st_mtime)}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
