#!/usr/bin/env python3
"""Print the worktree directory for a task: .worktrees/<short-id>-<title-slug>.

Usage: flow-worktree-dir <task-id>
Prints: .worktrees/<id without the bd issue prefix>-<slug>   e.g. .worktrees/elf.28-flow-worktree-dir-shorten-generated
Exit:   0 ok | 1 task not found | 2 bd error
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys

import _task_names

BD = os.environ.get("BD_BIN", "bd")


def read_issue_prefix(bd: str) -> str:
    result = subprocess.run(
        [bd, "config", "get", "issue_prefix", "--json"], capture_output=True, text=True, check=False
    )
    if result.returncode != 0:
        return ""
    try:
        value = json.loads(result.stdout).get("value")
    except (json.JSONDecodeError, AttributeError):
        return ""
    return value if isinstance(value, str) else ""


def main():
    parser = argparse.ArgumentParser(description="Compute the .worktrees/ directory for a beads task.")
    parser.add_argument("task_id")
    task_id = parser.parse_args().task_id

    try:
        issue = _task_names.read_issue(BD, task_id)
    except _task_names.TaskLookupError as e:
        sys.stderr.write(e.message + "\n")
        return e.code

    task_id = issue.get("id") or task_id  # bd resolves short ids; name from the full id it returns
    prefix = read_issue_prefix(BD)
    if prefix and task_id.startswith(prefix + "-"):
        short_id = task_id[len(prefix) + 1 :]
    else:
        short_id = task_id
        if not prefix:
            sys.stderr.write("cannot read issue_prefix from bd config; using full task id\n")
        else:
            sys.stderr.write(f"task id {task_id!r} does not start with issue prefix {prefix!r}; using full task id\n")

    slug = _task_names.slugify(issue.get("title", ""))
    if slug:
        sys.stdout.write(f".worktrees/{short_id}-{slug}\n")
    else:
        sys.stderr.write("title produces empty slug; using task-id only\n")
        sys.stdout.write(f".worktrees/{short_id}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
