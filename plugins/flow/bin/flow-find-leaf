#!/usr/bin/env python3
"""
Find leaf in_progress tasks from bd graph --all --json output and print a
display-ready list grouped by assignee.

A task is "leaf" if none of its children are in_progress.

Group order: mine -> Unassigned -> other users alphabetically.
Without --all only my tasks and unassigned tasks are shown.
When no identity can be resolved, behaves like --all.

Usage:
    bd graph --all --json | flow-find-leaf
    bd graph --all --json | flow-find-leaf --all
"""

import argparse
import json
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

TYPE_LETTERS = {"bug": "B", "feature": "F", "task": "T", "epic": "E", "chore": "C"}


@dataclass
class Task:
    id: str
    title: str
    status: str
    priority: int
    issue_type: str
    labels: list[str] = field(default_factory=list)
    assignee: str = ""
    children: list["Task"] = field(default_factory=list)
    parent_id: str | None = None


def parse_graphs(data: list[dict]) -> dict[str, Task]:
    """Parse all graphs into a flat dict of tasks."""
    tasks: dict[str, Task] = {}
    parent_map: dict[str, str] = {}

    for graph in data:
        for iss in graph.get("Issues") or []:
            task = Task(
                id=iss["id"],
                title=iss["title"],
                status=iss["status"],
                priority=iss.get("priority", 2),
                issue_type=iss.get("issue_type", "task"),
                labels=iss.get("labels", []),
                assignee=iss.get("assignee") or "",
            )
            tasks[task.id] = task

        for d in graph.get("Dependencies") or []:
            if d["type"] == "parent-child":
                parent_map[d["issue_id"]] = d["depends_on_id"]

    for child_id, parent_id in parent_map.items():
        if child_id in tasks and parent_id in tasks:
            tasks[child_id].parent_id = parent_id
            tasks[parent_id].children.append(tasks[child_id])

    return tasks


def find_leaf_in_progress(tasks: dict[str, Task]) -> list[Task]:
    """Find leaf in_progress tasks, sorted by (priority, id).

    A task is "leaf" if none of its children are in_progress.
    """
    result = []
    for task in tasks.values():
        if task.status != "in_progress":
            continue
        has_in_progress_child = any(c.status == "in_progress" for c in task.children)
        if not has_in_progress_child:
            result.append(task)

    return sorted(result, key=lambda t: (t.priority, t.id))


def get_actor() -> str | None:
    """Resolve the actor via the sibling flow-actor helper."""
    helper = Path(__file__).resolve().parent / "flow-actor"
    result = subprocess.run(
        [sys.executable, str(helper)],
        capture_output=True,
        text=True,
        check=False,
    )
    name = result.stdout.strip()
    if result.returncode != 0 or not name:
        return None
    return name


def select_tasks(tasks: list[Task], actor: str | None, *, show_all: bool) -> list[Task]:
    """Keep my and unassigned tasks; everything with --all or when no identity."""
    if show_all or actor is None:
        return tasks
    return [t for t in tasks if t.assignee in (actor, "")]


def group_tasks(tasks: list[Task], actor: str | None) -> list[tuple[str, list[Task]]]:
    """Group tasks: mine -> Unassigned -> other assignees alphabetically."""
    mine: list[Task] = []
    unassigned: list[Task] = []
    others: dict[str, list[Task]] = {}
    for task in tasks:
        if actor is not None and task.assignee == actor:
            mine.append(task)
        elif not task.assignee:
            unassigned.append(task)
        else:
            others.setdefault(task.assignee, []).append(task)

    groups: list[tuple[str, list[Task]]] = []
    if mine:
        groups.append((f"Мои задачи ({actor}):", mine))
    if unassigned:
        groups.append(("Unassigned:", unassigned))
    groups.extend((f"{name}:", others[name]) for name in sorted(others))
    return groups


def format_task_line(task: Task, number: int) -> str:
    """Format one numbered display line."""
    letter = TYPE_LETTERS.get(task.issue_type, "T")
    title = " ".join(task.title.split())
    line = f"{number}. [{letter}] {title} ({task.id}) | P{task.priority}"
    if task.labels:
        line += f" | #{task.labels[0]}"
    return line


def render(groups: list[tuple[str, list[Task]]]) -> str:
    """Render groups with continuous numbering; empty string when no tasks."""
    lines: list[str] = []
    number = 0
    for header, tasks in groups:
        if lines:
            lines.append("")
        lines.append(header)
        for task in tasks:
            number += 1
            lines.append(format_task_line(task, number))
    return "\n".join(lines)


def main() -> None:
    parser = argparse.ArgumentParser(description="Find leaf in_progress tasks grouped by assignee")
    parser.add_argument("--all", action="store_true", help="Show all users' tasks, grouped by assignee")
    args = parser.parse_args()

    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        print(f"Error parsing JSON: {e}", file=sys.stderr)
        sys.exit(1)

    if not data:
        sys.exit(0)

    tasks = parse_graphs(data)
    leaves = find_leaf_in_progress(tasks)
    actor = get_actor()
    selected = select_tasks(leaves, actor, show_all=args.all)
    output = render(group_tasks(selected, actor))
    if output:
        print(output)


if __name__ == "__main__":
    main()
