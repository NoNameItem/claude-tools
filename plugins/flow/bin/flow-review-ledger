#!/usr/bin/env python3
"""Persistent per-PR review ledger for flow:review-comments.

    flow-review-ledger reconcile --meta metadata.json
    flow-review-ledger get       --ref C1 [--meta metadata.json | --url URL --number N]
    flow-review-ledger record    --decisions decisions.json --head SHA [--meta … | --url … --number …]
    flow-review-ledger stats     [--meta … | --url … --number …] [--last-round]
    flow-review-ledger purge     [--meta … | --url … --number …]

Durable working memory keyed by thread id: what was found, what was decided about it, and
which of its messages — the comment itself and every reply — we have not acted on yet. A thread
is work iff the platform has it live and it holds such an unseen message (`_ledger.is_working`).
Pure stdlib. Every untrusted value (bodies, thread replies, `reason`) arrives by FILE and leaves
as JSON — nothing reviewer-controlled ever reaches a command line.

`record`'s decisions file merges into a row the way JSON merge does: an ABSENT key leaves the
stored value alone, an explicit `null` CLEARS it. Clearable fields: `decision`, `reason`,
`followup_task_id`. Two more keys are one-round instructions, never stored on the row:

- `settled: true` — the round delivered this thread's outcome. Only then does `record` paint the
  comment and every stored reply seen. Without it the decision is stored and nothing is painted,
  so the thread comes back next round with that decision as context.
- `reply` — the reply this round posted, with its `id`. Allowed only with `settled: true`;
  `record` appends it to the thread as the agent's, seen.

`status` was removed with the open/done model and is rejected, with a pointer to `settled`.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

import _ledger


def read_json(path: str) -> object:
    with Path(path).open(encoding="utf-8") as handle:
        return json.load(handle)


def resolve_unit(args: argparse.Namespace) -> tuple[str, object]:
    """(url, number) from --meta's `unit`, or from explicit --url/--number.

    When only --url is given, the number is derived from its route segment (GitHub
    `.../pull/<n>`, GitLab `.../-/merge_requests/<n>`) so hand-use of e.g. `purge --url …`
    doesn't require repeating the number the URL already carries. A URL with no derivable
    number leaves `number` as None, and `ledger_path` raises its existing clear error.
    """
    if getattr(args, "meta", None):
        meta = read_json(args.meta)
        unit = (meta.get("unit") or {}) if isinstance(meta, dict) else {}
        return unit.get("url", ""), unit.get("number")
    url = getattr(args, "url", "") or ""
    number = getattr(args, "number", None)
    if number is None:
        number = _ledger.derive_number(url)
    return url, number


# ---- reconcile ---------------------------------------------------------------


def alloc_ref(doc: dict, is_bot: bool) -> str:
    """Draw the next stable ref for a NEW row: `C` for bots, `U` for humans.

    Allocate-once: an existing row keeps its ref forever and a number is never reused, so a
    ref identifies the same finding across every round (the working set is therefore a sparse,
    gappy subset of refs — gaps are threads with nothing unseen, or off the platform).
    """
    prefix = "C" if is_bot else "U"
    counters = doc["next_ref"]
    number = int(counters.get(prefix, 1))
    counters[prefix] = number + 1
    return f"{prefix}{number}"


def refresh_snapshot(row: dict, item: dict) -> None:
    """Rebuild the current-snapshot fields from the fresh collector output. Durable and
    set-on-insert fields are untouched.

    `resolved` is not one of these fields any more — the platform axis (`platform_state`,
    written unconditionally in `cmd_reconcile`) is computed straight from `item`, so the row
    never stores the platform's raw verdict at all.
    """
    for field in _ledger.SNAPSHOT_FIELDS:
        row[field] = item.get(field)


def seed_thread(item: dict, me: object) -> tuple[bool, list[dict]]:
    """`(comment_seen, thread)` for a thread the ledger has never held.

    Every reply carries its `author_role`, and the thread is in chronological order. When the
    thread already holds a reply of the agent's, the comment and every reply up to and including
    the LAST such reply arrive seen, and the replies after it arrive unseen. With no agent reply
    everything arrives unseen.

    This replaces the collector's `already_replied` seeding, which asked "is the last replier
    `me`?". The owner posts from that same account, so on PR #151 the owner's own answer to a
    fresh Codex comment seeded the row settled and hid it (see the 2026-10-23 unseen-signal
    design). Only the agent marker, together with the run account, says a reply is ours.

    Applies to NEW rows only. Run against a row the ledger already holds it would bring back C2:
    a reviewer reply that landed while the round was in triage would be painted seen by our
    later reply. An existing row takes replies one at a time through `merge_thread` instead.
    In practice this fires on a lost ledger (cache cleared, or a corrupt file degraded to
    empty). It is kept for that case because the failure it prevents is public: re-triaging
    every answered thread posts a second reply into each.
    """
    thread = sorted(
        (
            {**reply, "author_role": _ledger.author_role(reply, me)}
            for reply in item.get("thread") or []
            if isinstance(reply, dict)
        ),
        key=_ledger.reply_order,
    )
    agent_at = [index for index, reply in enumerate(thread) if reply["author_role"] == "agent"]
    last_agent = agent_at[-1] if agent_at else -1
    for index, reply in enumerate(thread):
        reply["seen"] = index <= last_agent
    return bool(agent_at), thread


def comment_role(item: dict, me: object) -> str:
    """'owner' or 'reviewer' for the comment that opens a thread — never 'agent'.

    The agent only ever answers a thread, so a comment from the run account is the owner's, and
    a marker in it changes nothing. Goes through `_ledger.author_role` so an unknown run account
    still makes nobody the owner.
    """
    return "reviewer" if _ledger.author_role(item, me) == "reviewer" else "owner"


def new_row(thread_id: str, item: dict, doc: dict, round_no: int, me: object) -> dict:
    kind = item.get("kind") or "inline"
    comment_seen, thread = seed_thread(item, me)
    row = {
        # The BARE platform id — the reply target. The ledger's own key is namespaced
        # (`_ledger.row_key_of`); the two must not be conflated, or a prefixed value would
        # reach `.../comments/{id}/replies` and 404 every reply.
        "thread_id": thread_id,
        "platform": (doc.get("unit") or {}).get("platform"),
        "ref": alloc_ref(doc, bool(item.get("is_bot"))),
        "kind": kind,
        # The comment's own bit, with a reply's meaning: the workflow acted on this thread with
        # this message in front of it. Resolution does not seed it: a row first seen resolved is
        # stored unseen, so if the thread is un-resolved it arrives for triage instead of staying
        # closed by someone else's verdict forever.
        "seen": comment_seen,
        # Set on insert, and this is its only writer.
        "author_role": comment_role(item, me),
        "decision": None,
        "reason": None,
        "followup_task_id": None,
        # Set on insert and never refreshed — see SNAPSHOT_FIELDS.
        "body": item.get("body"),
        "thread": thread,
        "first_seen_round": round_no,
        "last_round": round_no,
        "head": None,
    }
    refresh_snapshot(row, item)
    return row


def merge_thread(row: dict, item: dict, me: object) -> None:
    """Append forge replies we do not already hold, then restore chronological order.

    A new reply arrives seen only when it is the agent's — marked AND from the run account — so
    a reply we posted but failed to report (the POST succeeded, the id extraction did not) still
    cannot come back as foreign and draw a second reply. Every other new reply arrives unseen,
    the owner's included: an owner's comment in an answered thread is exactly what must bring it
    back. Nothing already stored is repainted, which keeps C2 closed.

    Ids normalise through `str()` on both sides: GitHub returns a numeric `.id` and the agent
    may hand the same id back as text; a naive comparison would store our own reply a second
    time.

    A reply whose id we already hold is dropped rather than refreshed, so an edit made in place
    on the forge does not rewrite what we stored — the same rule the comment's own `body`
    follows.
    """
    if not isinstance(row.get("thread"), list):
        row["thread"] = []
    thread = row["thread"]
    known = {str(reply.get("id")) for reply in thread if isinstance(reply, dict)}
    for reply in item.get("thread") or []:
        if isinstance(reply, dict) and str(reply.get("id")) not in known:
            role = _ledger.author_role(reply, me)
            thread.append({**reply, "author_role": role, "seen": role == "agent"})
    thread.sort(key=_ledger.reply_order)


def working_entry(row: dict) -> dict:
    """The display projection that feeds Phase 3's working set — no bodies, no threads."""
    brief = " ".join((row.get("body") or "").split())[: _ledger.BRIEF_CHARS]
    return {
        "ref": row.get("ref"),
        "kind": row.get("kind"),
        "is_bot": bool(row.get("is_bot")),
        "path": row.get("path"),
        "start_line": row.get("start_line"),
        "line": row.get("line"),
        "outdated": bool(row.get("outdated")),
        "decision": row.get("decision"),
        "first_seen_round": row.get("first_seen_round"),
        "brief": brief,
    }


def bucket_counts(rows: list) -> dict:
    """The four buckets that PARTITION every row, shared by `reconcile`'s counts and `stats`.

    - `done`: nothing unseen, whatever the platform says;
    - `open`: `_ledger.is_working` — live, with something unseen;
    - `resolved_upstream` / `absent_upstream`: something unseen, in a thread the platform
      resolved or dropped — out of the working set without the workflow having acted on it.

    One home, so the payload `reconcile` prints and the report `stats` prints cannot sort the
    same row into different buckets.
    """
    unseen = [row for row in rows if _ledger.has_unseen(row)]
    return {
        "done": sum(1 for row in rows if not _ledger.has_unseen(row)),
        "open": sum(1 for row in unseen if _ledger.is_working(row)),
        "resolved_upstream": sum(1 for row in unseen if row.get("platform_state") == "resolved"),
        "absent_upstream": sum(1 for row in unseen if row.get("platform_state") == "absent"),
    }


def counts_of(doc: dict, working: list | None = None) -> dict:
    """Bucket tallies plus `total` and `working` — the size of the CURRENT set.

    `working` must be the list `reconcile` actually emitted, not a tally over all rows: the
    skill's Phase-2 gate treats `counts.working` as `len(working_set)`, and the two populations
    differ (a row can be persisted but absent from this round's snapshot). The row-derived
    fallback goes through `_ledger.is_working` so it cannot drift from the loop above.
    """
    rows = list(doc.get("rows", {}).values())
    counts = bucket_counts(rows)
    counts["total"] = len(rows)
    counts["working"] = counts["open"] if working is None else len(working)
    return counts


def cmd_reconcile(args: argparse.Namespace) -> int:
    meta = read_json(args.meta)
    unit = (meta.get("unit") or {}) if isinstance(meta, dict) else {}
    me = meta.get("me") if isinstance(meta, dict) else None
    path = _ledger.ledger_path(unit.get("url", ""), unit.get("number"))
    doc = _ledger.load_ledger(path)
    doc["unit"] = {"platform": meta.get("platform"), "number": unit.get("number"), "url": unit.get("url")}
    doc["round"] = int(doc.get("round", 0)) + 1
    round_no = doc["round"]

    comments = meta.get("comments") if isinstance(meta, dict) else None
    if comments is not None and not isinstance(comments, list):
        msg = f"meta.comments must be a list, got {type(comments).__name__}"
        raise ValueError(msg)

    working = []
    in_snapshot: set[str] = set()
    for item in comments or []:
        thread_id = _ledger.thread_id_of(item)
        key = _ledger.row_key_of(item)
        if thread_id is None or key is None:
            continue  # no platform id → not trackable
        in_snapshot.add(key)
        row = doc["rows"].get(key)
        if row is None:
            row = new_row(thread_id, item, doc, round_no, me)
            doc["rows"][key] = row
        else:
            merge_thread(row, item, me)
            refresh_snapshot(row, item)
        # The platform axis, for new and existing rows alike — one writer, one statement.
        row["platform_state"] = _ledger.platform_state_of(item)
        if _ledger.is_working(row):
            working.append(working_entry(row))

    # Absence is the third platform state: a tracked row missing from this round's snapshot is
    # gone from the platform, and its `seen` bits / `decision` / `reason` / `followup_task_id`
    # are left exactly as they were. If the thread comes back, the loop above returns the row
    # to `live` and it resumes with its decision intact.
    #
    # Absence is trustworthy because the collector aborts on any API failure rather than
    # returning a short page, so "not in the snapshot" cannot mean "not fetched".
    for key, row in doc["rows"].items():
        if key not in in_snapshot:
            row["platform_state"] = "absent"

    _ledger.save_ledger(path, doc)
    payload = {"round": round_no, "ledger": str(path), "counts": counts_of(doc, working), "working_set": working}
    print(json.dumps(payload))
    return 0


# ---- get ---------------------------------------------------------------------


def cmd_get(args: argparse.Namespace) -> int:
    """Print ONE row as JSON. The read primitive that keeps every consumer — the Phase-3
    subagent, the Phase-4 card, the Phase-5 reply target — off the whole growing document.

    The row goes out exactly as stored, with no computed fields: every message carries its own
    `seen` bit, so a reader learns what is new from the row itself.
    """
    url, number = resolve_unit(args)
    doc = _ledger.load_ledger(_ledger.ledger_path(url, number))
    row = _ledger.find_row_by_ref(doc, args.ref)
    if row is None:
        print(f"flow-review-ledger: no row with ref {args.ref!r}", file=sys.stderr)
        return 1
    print(json.dumps(row, ensure_ascii=False))
    return 0


# ---- record ------------------------------------------------------------------


def validate_decisions(decisions: object) -> None:
    """Reject a malformed decisions file BEFORE touching the ledger (all-or-nothing).

    The one thing an entry says beyond its stored fields is whether the round DELIVERED the
    thread's outcome — `"settled": true`. A delivered outcome paints the thread seen; anything
    else (an apply that failed, a follow-up batch the user cancelled) stores the decision and
    paints nothing, so the thread is back next round with that decision as context. There is no
    third, deferred state: a decided-but-withheld row would be exactly the "pending" signal the
    2026-10-23 unseen-signal design removed from selection. Hence:

    - `settled` must be a real bool. `1`, `"yes"` or `null` cannot say unambiguously whether
      the outcome landed, and guessing wrong either hides a thread or re-triages a delivered one.
    - `reply` is allowed only with `settled: true`. A posted reply IS a delivered outcome; a
      reply on an unsettled entry is a contradiction, not something to resolve by guessing.
    - `status` was removed with the open/done model. It is rejected, not ignored, so a caller
      still writing it learns to say `settled` instead of having its outcome silently dropped.
    """
    if not isinstance(decisions, dict):
        msg = "decisions file must be a JSON object keyed by ref"
        raise ValueError(msg)
    for ref, entry in decisions.items():
        if not isinstance(entry, dict):
            msg = f"decision for {ref} must be an object"
            raise ValueError(msg)
        if "status" in entry:
            msg = (
                f'decision for {ref} carries "status", which was removed — '
                'mark a delivered outcome with "settled": true'
            )
            raise ValueError(msg)
        if "settled" in entry and not isinstance(entry["settled"], bool):
            msg = f'decision for {ref} has a "settled" that is not true or false: {entry["settled"]!r}'
            raise ValueError(msg)
        decision = entry.get("decision")
        if decision is not None and decision not in _ledger.DECISIONS:
            msg = f"decision for {ref} has unknown decision {decision!r}"
            raise ValueError(msg)
        if "reply" in entry:
            posted = entry["reply"]
            if not isinstance(posted, dict) or posted.get("id") is None:
                msg = f"decision for {ref} has a `reply` that is not an object with an `id`"
                raise ValueError(msg)
            if entry.get("settled") is not True:
                msg = (
                    f'decision for {ref} has a `reply` without "settled": true — a posted reply is a delivered outcome'
                )
                raise ValueError(msg)


#: Every field `record` can update on a row, with ordinary JSON-merge semantics:
#: an ABSENT key is a no-op ("this round supplied no new information"), an explicit JSON
#: `null` CLEARS the stored value. review-comments 5.7a's canonical decisions.json relies on
#: the clear — a ref re-decided `fix` writes `"followup_task_id": null` to drop the task id an
#: earlier `follow_up` round filed. Every stored field is nullable, so the two lists are one.
NULLABLE_FIELDS = ("decision", "reason", "followup_task_id")
RECORD_FIELDS = NULLABLE_FIELDS


def paint_seen(row: dict, posted: object) -> None:
    """Mark the comment and every stored reply as acted-on, then append the reply this round
    posted, as the agent's.

    Called only for an entry marked `"settled": true` — the round delivered the thread's
    outcome, which is what `seen` asserts. It paints only what the row STORES: a reply that
    landed after this round's collect is not stored yet, so it arrives next round unseen (C2).

    The append is idempotent by id, normalised through `str()` on both sides: 5.7 checkpoints a
    ref the moment its reply is accepted and 5.7a records it again, and the same id handed back
    as text must not store a second copy.
    """
    row["seen"] = True
    if not isinstance(row.get("thread"), list):
        row["thread"] = []
    thread = row["thread"]
    for stored in thread:
        if isinstance(stored, dict):
            stored["seen"] = True
    if not isinstance(posted, dict):
        return
    known = {str(stored.get("id")) for stored in thread if isinstance(stored, dict)}
    if str(posted.get("id")) not in known:
        thread.append({**posted, "author_role": "agent", "seen": True})
        thread.sort(key=_ledger.reply_order)


def cmd_record(args: argparse.Namespace) -> int:
    url, number = resolve_unit(args)
    path = _ledger.ledger_path(url, number)
    if not path.is_file():
        # Phase 5.7a always runs `record` immediately after `reconcile` in the same run, which
        # unconditionally saves the ledger — so a missing file here means something upstream
        # went wrong. Materialising an empty round-0 document would silently hide that.
        msg = f"no ledger at {path} — run reconcile before record"
        raise ValueError(msg)
    decisions = read_json(args.decisions)
    validate_decisions(decisions)

    doc = _ledger.load_ledger(path)
    unknown = []
    for ref, entry in decisions.items():
        row = _ledger.find_row_by_ref(doc, ref)
        if row is None:
            unknown.append(ref)
            continue
        for field in RECORD_FIELDS:
            if field in entry:
                row[field] = entry[field]
        if entry.get("settled") is True:
            paint_seen(row, entry.get("reply"))
        row["last_round"] = doc.get("round", 0)
        row["head"] = args.head
    _ledger.save_ledger(path, doc)

    print(json.dumps({"recorded": len(decisions) - len(unknown), "unknown": sorted(unknown)}))
    if unknown:
        # Non-zero per the plugin's exit-code convention (AGENTS.md: "no silent failures").
        # The entries that DID apply are already saved above — the caller's decisions are
        # never lost — but the caller must not treat the batch as durable: an unrecorded
        # finding keeps its messages unseen, comes back next round, and gets re-triaged after a
        # reply was already posted for it. Nothing inspects the JSON, so the exit code is the
        # only signal that reaches Phase 5.7a.
        print(f"flow-review-ledger: no row for ref(s) {', '.join(sorted(unknown))}", file=sys.stderr)
        return 1
    return 0


# ---- stats -------------------------------------------------------------------

DECISION_LABELS = (
    ("fix", "fix"),
    ("wont_fix", "won't-fix"),
    ("follow_up", "follow-up"),
    ("outdated", "outdated"),
)


def fold_stats(doc: dict, last_round_only: bool) -> dict:
    rows = list(doc.get("rows", {}).values())
    if last_round_only:
        rows = [row for row in rows if row.get("last_round") == doc.get("round")]
    # The same four buckets `reconcile` counts (`bucket_counts`), so the report can never
    # contradict it: nothing in the working set, yet `Open: 1`.
    settled = [row for row in rows if not _ledger.has_unseen(row)]
    return {
        "tracked": len(rows),
        **bucket_counts(rows),
        # A working row that already carries a decision is one whose action did not land — an
        # apply that failed, a follow-up batch that was cancelled. It is triaged again next round
        # with that decision as context.
        "open_decided": sum(1 for row in rows if _ledger.is_working(row) and row.get("decision")),
        # Tallied over settled rows only: a decision on a row still holding something unseen has
        # not been delivered, or has been answered by a message nobody has looked at yet.
        "decisions": {key: sum(1 for row in settled if row.get("decision") == key) for key, _ in DECISION_LABELS},
        "followups": [
            row["followup_task_id"]
            for row in rows
            if row.get("decision") == "follow_up" and row.get("followup_task_id")
        ],
    }


def render_stats(doc: dict, folded: dict, last_round_only: bool) -> str:
    unit = doc.get("unit") or {}
    noun, marker = ("MR", "!") if unit.get("platform") == "gitlab" else ("PR", "#")
    try:
        host, segments = _ledger.split_project(unit.get("url", ""))
        location = "/".join([host, *segments])
    except _ledger.LedgerPathError:
        location = unit.get("url") or "?"
    suffix = " (last pass)" if last_round_only else ""
    lines = [
        f"Ledger {noun} {marker}{unit.get('number')} ({location}) — round {doc.get('round', 0)}{suffix}",
        f"  Tracked: {folded['tracked']} findings",
    ]
    breakdown = " · ".join(
        f"{label} {folded['decisions'][key]}" for key, label in DECISION_LABELS if folded["decisions"][key]
    )
    done = f"  Done: {folded['done']}"
    lines.append(f"{done}  ({breakdown})" if breakdown else done)
    # `flow:review-loop` parses this line as the size of what is left: keep it `Open: N`.
    open_line = f"  Open: {folded['open']}"
    if folded["open_decided"]:
        # Only when non-zero: on a clean round every open row is simply untriaged, and a
        # permanent "(decided, action did not land: 0)" would read as noise.
        open_line += f"  (decided, action did not land: {folded['open_decided']})"
    lines.append(open_line)
    if folded["absent_upstream"]:
        lines.append(f"  Deleted upstream: {folded['absent_upstream']}")
    if folded["resolved_upstream"]:
        # Same rule, and the counterpart to the line above: these rows still hold something the
        # workflow never acted on, but the platform took them off the table — reporting them
        # under `Open` would be wrong, hiding them entirely worse.
        lines.append(f"  Resolved upstream: {folded['resolved_upstream']}")
    if folded["followups"]:
        lines.append(f"  Follow-ups filed: {len(folded['followups'])} ({', '.join(folded['followups'])})")
    return "\n".join(lines)


def cmd_stats(args: argparse.Namespace) -> int:
    url, number = resolve_unit(args)
    path = _ledger.ledger_path(url, number)
    if not path.is_file():
        print(f"No ledger for {url} (nothing tracked yet).")
        return 0
    doc = _ledger.load_ledger(path)
    print(render_stats(doc, fold_stats(doc, args.last_round), args.last_round))
    return 0


# ---- purge -------------------------------------------------------------------


def cmd_purge(args: argparse.Namespace) -> int:
    """Remove one PR's ledger. Path + unlink only; no untrusted data, idempotent."""
    url, number = resolve_unit(args)
    path = _ledger.ledger_path(url, number)
    existed = path.is_file()
    path.unlink(missing_ok=True)
    print(f"Removed ledger {path}" if existed else f"No ledger at {path}")
    return 0


# ---- entry point -------------------------------------------------------------


def add_unit_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--meta")
    parser.add_argument("--url")
    parser.add_argument("--number")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="flow-review-ledger")
    sub = parser.add_subparsers(dest="command", required=True)

    reconcile = sub.add_parser("reconcile")
    reconcile.add_argument("--meta", required=True)
    reconcile.set_defaults(func=cmd_reconcile)

    get = sub.add_parser("get")
    get.add_argument("--ref", required=True)
    add_unit_args(get)
    get.set_defaults(func=cmd_get)

    record = sub.add_parser(
        "record",
        description=(
            "Merge a decisions file into the ledger. Per entry, an ABSENT key is a no-op and an "
            "explicit null CLEARS the field. Clearable: decision, reason, followup_task_id. "
            '"settled": true says the round delivered the outcome; only then are the comment and '
            "every stored reply painted seen — without it the decision is stored and the thread "
            "comes back next round. `reply` names the reply this round posted (with its id); it is "
            'allowed only with "settled": true and is appended to the thread as the agent\'s, seen. '
            "Neither key is stored. status was removed and is rejected."
        ),
    )
    record.add_argument("--decisions", required=True)
    record.add_argument("--head", required=True)
    add_unit_args(record)
    record.set_defaults(func=cmd_record)

    stats = sub.add_parser("stats")
    stats.add_argument("--last-round", action="store_true")
    add_unit_args(stats)
    stats.set_defaults(func=cmd_stats)

    purge = sub.add_parser("purge")
    add_unit_args(purge)
    purge.set_defaults(func=cmd_purge)

    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except (OSError, ValueError) as exc:  # LedgerPathError is a ValueError
        print(f"flow-review-ledger: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
